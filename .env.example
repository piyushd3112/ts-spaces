# Set the real HTTPS origin before production build (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# HTTPS endpoint accepting a JSON POST; return 2xx only after durable acceptance.
# Leave empty to keep the inquiry form disabled and the API returning 503.
INQUIRY_WEBHOOK_URL=
# Optional server-only bearer credential. Never prefix this with NEXT_PUBLIC_.
INQUIRY_WEBHOOK_TOKEN=
# Optional verified Google Maps embed URL (no client API key).
NEXT_PUBLIC_MAP_EMBED_URL=
